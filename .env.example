# Ticketmaster Developer Portal에서 발급받은 Consumer Key
TICKETMASTER_API_KEY=your_consumer_key_here

# Sharing metadata uses the canonical Korea trip URL: https://shawnai.win/ktravel

# Trip accounts use DB-backed roles and HttpOnly sessions.
# Provision reserved Shawn/Sun accounts locally; see docs/TRIP_AUTH.md.
# Optional shared departure configuration, used by camera and both providers:
# TRIP_ORIGIN_JSON={"name":"Seoul Station","longitude":126.9707793,"latitude":37.5545547}

# Kakao Mobility driving directions: server-only REST API key (never NEXT_PUBLIC_*).
# Public local Worker reads /Users/shawn/.config/ktravel/kakao.env via --env-file.
# See docs/KAKAO_DIRECTIONS.md. Leave empty until an actual key is issued.
KAKAO_MOBILITY_REST_API_KEY=

# Optional English AI host; server-only values, never NEXT_PUBLIC_*.
# Provision the isolated ktravel-voice OpenClaw agent before adding its token.
# The public/local Worker reads the same private runtime env file as directions.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
OPENCLAW_GATEWAY_TOKEN=

# Enable only after provisioning the isolated ktravel-assistant agent (no tools, memory or context injection).
OPENCLAW_TRIP_ASSISTANT_ISOLATED=false
